        {
          "name": "List Global Instruments",
          "request": {
            "method": "GET",
            "header": [
              { "key": "Authorization", "value": "Bearer {{jwt_token}}" }
            ],
            "url": {
              "raw": "{{base_url}}/admin/global-instruments?page=1&limit=20&include_deleted=false&status=ACTIVE&segment=FOREX&exchange=FOREX&instrument_type=SPOT&search=GBP",
              "host": ["{{base_url}}"],
              "path": ["admin", "global-instruments"],
              "query": [
                { "key": "page", "value": "1" },
                { "key": "limit", "value": "20" },
                { "key": "include_deleted", "value": "false" },
                { "key": "status", "value": "ACTIVE" },
                { "key": "segment", "value": "FOREX" },
                { "key": "exchange", "value": "FOREX" },
                { "key": "instrument_type", "value": "SPOT" },
                { "key": "search", "value": "GBP" },
                { "key": "expiry", "value": "2026-05-26" }
              ]
            },
            "description": "Paginated list of global instruments.\nDefault request can use only page and limit.\nSupported optional query params:\n- include_deleted\n- status: ACTIVE or INACTIVE\n- segment: OTHERS, USSTOCK, COMEX, CRYPTO, FOREX, GIFT\n- exchange: OTHERS, USSTOCK, COMEX, CRYPTO, FOREX, GIFT\n- instrument_type\n- expiry: YYYY-MM-DD, DD-MM-YYYY, DD-MM-YY, or RFC3339\n- search: matches symbol, subscribe_symbol_name, tradingsymbol, or name\n\nResponse shape matches admin instruments list with status_code, message, instruments, and pagination."
          }
        },
        {
          "name": "Import Global Instruments",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Authorization", "value": "Bearer {{jwt_token}}" }
            ],
            "body": {
              "mode": "formdata",
              "formdata": [
                {
                  "key": "file",
                  "type": "file",
                  "src": ""
                }
              ]
            },
            "url": {
              "raw": "{{base_url}}/admin/global-instruments/import",
              "host": ["{{base_url}}"],
              "path": ["admin", "global-instruments", "import"]
            },
            "description": "Bulk create or update global instruments from CSV/XLSX/XLSM file.\nConflict key: symbol. Existing row with same symbol will be updated.\nSupports your current sheet format with these columns in order:\n- instrument_token\n- exchange_token\n- tradingsymbol\n- name\n- subscribe_symbol_name\n- last_price\n- expiry (DD/MM/YY also supported)\n- last_price (used as strike column from the shared sheet format)\n- tick_size\n- lot_size\n- instrument_type\n- segment\n- exchange\n\nAlso supports extended format with symbol, strike, status, and is_deleted columns."
          }
        },
        {
          "name": "Create Global Instrument",
          "event": [{
            "listen": "test",
            "script": {
              "type": "text/javascript",
              "exec": [
                "let r = pm.response.json();",
                "if (r && r.global_instrument && r.global_instrument.id) pm.collectionVariables.set('global_instrument_id', r.global_instrument.id);"
              ]
            }
          }],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{jwt_token}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"instrument_token\": 101001,\n  \"exchange_token\": 501001,\n  \"tradingsymbol\": \"GBPUSD\",\n  \"name\": \"British Pound/USD\",\n  \"subscribe_symbol_name\": \"GBPUSD\",\n  \"symbol\": \"GBPUSD\",\n  \"last_price\": 1.2765,\n  \"expiry\": null,\n  \"tick_size\": 0.0001,\n  \"lot_size\": 1,\n  \"instrument_type\": \"SPOT\",\n  \"segment\": \"FOREX\",\n  \"exchange\": \"FOREX\",\n  \"strike\": 0,\n  \"status\": \"ACTIVE\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/admin/global-instruments",
              "host": ["{{base_url}}"],
              "path": ["admin", "global-instruments"]
            },
            "description": "Create a new global instrument.\nBody fields:\n- symbol: required (auto-derived from subscribe_symbol_name or tradingsymbol if empty)\n- instrument_token, exchange_token, tradingsymbol, subscribe_symbol_name\n- last_price, expiry, tick_size, lot_size, instrument_type, strike\n- segment: OTHERS, USSTOCK, COMEX, CRYPTO, FOREX, GIFT\n- exchange: OTHERS, USSTOCK, COMEX, CRYPTO, FOREX, GIFT\n- status: ACTIVE or INACTIVE"
          }
        },
        {
          "name": "Update Global Instrument (Status/Delete/Undelete)",
          "request": {
            "method": "PUT",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{jwt_token}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"instrument_token\": 101001,\n  \"exchange_token\": 501001,\n  \"tradingsymbol\": \"GBPUSD\",\n  \"name\": \"British Pound/USD\",\n  \"subscribe_symbol_name\": \"GBPUSD\",\n  \"symbol\": \"GBPUSD\",\n  \"last_price\": 1.278,\n  \"expiry\": null,\n  \"tick_size\": 0.0001,\n  \"lot_size\": 1,\n  \"instrument_type\": \"SPOT\",\n  \"segment\": \"FOREX\",\n  \"exchange\": \"FOREX\",\n  \"strike\": 0,\n  \"status\": \"INACTIVE\",\n  \"is_deleted\": true\n}"
            },
            "url": {
