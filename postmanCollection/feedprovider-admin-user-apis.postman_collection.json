              ],
              "path": [
                "api",
                "refresh-token"
              ]
            },
            "description": "Refresh both API token and JWT token for current logged in user.\nBody requires old_token = current api_token.\nPostman test script updates collection tokens automatically."
          },
          "response": []
        }
      ]
