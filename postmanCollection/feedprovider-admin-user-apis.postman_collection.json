        {
          "name": "Refresh Token",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "let r = pm.response.json();",
                  "if (r && r.token) {",
                  "  if (r.token.jwt_token) pm.collectionVariables.set('jwt_token', r.token.jwt_token);",
                  "  if (r.token.api_token) pm.collectionVariables.set('api_token', r.token.api_token);",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{jwt_token}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"old_token\": \"{{api_token}}\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/api/refresh-token",
              "host": [
