              "host": ["{{base_url}}"],
              "path": ["admin", "global-instruments", "{{global_instrument_id}}"]
            },
            "description": "Update, soft delete, or undelete a global instrument by ID.\nSupports full global instrument model fields including token/symbol metadata and enums.\nSet is_deleted=true for soft delete, false for undelete."
          }
