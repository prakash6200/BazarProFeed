    {
      "name": "Auth APIs",
      "item": [
        {
          "name": "Signup",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"{{username}}\",\n  \"password\": \"{{password}}\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/auth/signup",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "auth",
                "signup"
              ]
            },
            "description": "Create a normal USER account.\nValidation:\n- username: 3 to 50 chars\n- password: minimum 6 chars"
          },
          "response": []
        },
        {
          "name": "Login",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "let r = pm.response.json();",
                  "if (r && r.token) {",
                  "  if (r.token.jwt_token) pm.collectionVariables.set('jwt_token', r.token.jwt_token);",
                  "  if (r.token.api_token) pm.collectionVariables.set('api_token', r.token.api_token);",
                  "}",
                  "if (r && r.user && r.user.id) pm.collectionVariables.set('user_id', r.user.id);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"{{username}}\",\n  \"password\": \"{{password}}\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/auth/login",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "auth",
                "login"
              ]
            },
            "description": "Login and generate JWT + API token.\nPostman test script auto-saves:\n- jwt_token\n- api_token"
          },
          "response": []
        }
      ]
    },
